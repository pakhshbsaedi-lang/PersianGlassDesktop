<Window x:Class="PersianGlassDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PersianGlass Desktop"
        Width="390" Height="850" MinWidth="350" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="True"
        FontFamily="B Yekan">
    <Window.Resources>
        <SolidColorBrush x:Key="Glass" Color="#D91B2638"/>
        <SolidColorBrush x:Key="Glass2" Color="#B526354B"/>
        <SolidColorBrush x:Key="Line" Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="MainText" Color="#FFF5F7FB"/>
        <SolidColorBrush x:Key="MutedText" Color="#FFB8C4D6"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="B Titr"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFF2F6FF"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
            <Setter Property="Background" Value="#263F5877"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontFamily" Value="B Yekan"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Glass2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="25" Background="{StaticResource Glass}"
            BorderBrush="#66FFFFFF" BorderThickness="1" Padding="15">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="PERSIAGLASS" FontFamily="Segoe UI" FontSize="9"
                       Foreground="#FF91B8E8" FontWeight="Bold"/>
            <TextBlock Text="داشبورد رومیزی" FontFamily="B Titr" FontSize="17"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="PinButton" Style="{StaticResource GlassButton}" Content="📌" ToolTip="همیشه بالا" Click="Pin_Click" Margin="3,0"/>
            <Button x:Name="LockButton" Style="{StaticResource GlassButton}" Content="🔓" ToolTip="قفل موقعیت" Click="Lock_Click" Margin="3,0"/>
            <Button Style="{StaticResource GlassButton}" Content="—" Click="Minimize_Click" Margin="3,0"/>
            <Button Style="{StaticResource GlassButton}" Content="×" Click="Close_Click" Margin="3,0"/>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <Border Style="{StaticResource Tile}" Padding="15">
              <StackPanel>
                <TextBlock Text="ساعت ایران" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="ClockText" Text="۰۰:۰۰:۰۰" FontFamily="B Yekan"
                           FontSize="43" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,0,0,-2"/>
                <TextBlock x:Name="WeekdayText" Text="روز هفته" FontFamily="B Titr"
                           FontSize="15" HorizontalAlignment="Center" Foreground="#FFB9D7FF"/>
                <TextBlock x:Name="JalaliText" Text="تاریخ شمسی" FontSize="19"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="GregorianText" Text="Gregorian date" FontFamily="Segoe UI"
                           FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                <TextBlock x:Name="HijriText" Text="التاريخ الهجري" FontFamily="Segoe UI"
                           FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedText}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="تقویم و مناسبت‌ها" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="MonthText" DockPanel.Dock="Right" Foreground="#FFB9D7FF"
                             FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
                <UniformGrid x:Name="CalendarGrid" Columns="7"/>
                <TextBlock Text="مناسبت‌ها و تعطیلات رسمی در نسخه بعد از بسته داده آفلاین تکمیل می‌شوند."
                           FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="آب‌وهوای اهواز" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="🌤️" FontSize="31" DockPanel.Dock="Right"/>
                </DockPanel>
                <TextBlock Text="اتصال به سرویس هواشناسی تنظیم نشده" FontSize="13"/>
                <TextBlock Text="دما، رطوبت، باد، پیش‌بینی ۷ روزه و AQI پس از اتصال منبع داده نمایش داده می‌شود."
                           FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,5,0,0"/>
                <TextBlock Text="آفلاین: آخرین داده ذخیره‌شده نمایش داده خواهد شد." FontSize="10"
                           Foreground="#FFFFD28A" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="بازارها" Style="{StaticResource SectionTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="دلار آزاد" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="— تومان" FontSize="18" FontWeight="SemiBold"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="نفت برنت" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="— دلار / بشکه" FontSize="16" FontWeight="SemiBold"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="قیمت‌ها تا زمان تعیین منبع معتبر، عمداً خالی هستند."
                           FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="خورشید و اوقات شرعی اهواز" Style="{StaticResource SectionTitle}"/>
                <UniformGrid Columns="2">
                  <StackPanel><TextBlock Text="🌅 طلوع" Style="{StaticResource SmallLabel}"/><TextBlock Text="—:—" FontSize="17"/></StackPanel>
                  <StackPanel><TextBlock Text="🌇 غروب" Style="{StaticResource SmallLabel}"/><TextBlock Text="—:—" FontSize="17"/></StackPanel>
                  <StackPanel Margin="0,8,0,0"><TextBlock Text="اذان صبح" Style="{StaticResource SmallLabel}"/><TextBlock Text="—:—"/></StackPanel>
                  <StackPanel Margin="0,8,0,0"><TextBlock Text="اذان مغرب" Style="{StaticResource SmallLabel}"/><TextBlock Text="—:—"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="روش محاسبه و منبع اوقات شرعی در تنظیمات قابل تعیین خواهد بود."
                           FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="یادآور و شمارش معکوس" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="هنوز یادآوری ثبت نشده است" FontSize="12"/>
                <TextBlock Text="نوروز · شمارش معکوس در نسخه بعد فعال می‌شود" FontSize="11"
                           Foreground="{StaticResource MutedText}" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="2,10,2,0">
          <TextBlock Text="نسخه نمایشی · داده‌های آنلاین هنوز متصل نیستند"
                     FontSize="9" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Content="تنظیمات" Style="{StaticResource GlassButton}"
                  Click="Settings_Click"/>
        </DockPanel>
      </Grid>
    </Border>
</Window>
