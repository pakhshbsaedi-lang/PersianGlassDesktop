```xml
<Window x:Class="PersianGlassDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PersianGlass Desktop"
 Width="370" Height="650"
 MinWidth="340" MinHeight="560"
 WindowStyle="None"
 ResizeMode="CanResizeWithGrip"
 AllowsTransparency="True"
 Background="Transparent"
 Topmost="False"
 ShowInTaskbar="False"
 FlowDirection="RightToLeft"
 FontFamily="B Yekan">

 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#FFFFFBFF"/>
  <SolidColorBrush x:Key="Muted" Color="#FFD0D9E8"/>

  <Style TargetType="TextBlock">
   <Setter Property="FontFamily" Value="B Yekan"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Small" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="B Nazanin"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#A62A3857"/>
   <Setter Property="BorderBrush" Value="#70C7F3FF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="15"/>
   <Setter Property="Padding" Value="9"/>
   <Setter Property="Margin" Value="4"/>
  </Style>

  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#554B7194"/>
   <Setter Property="BorderBrush" Value="#77B8E8F5"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,3"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontFamily" Value="B Yekan"/>
  </Style>
 </Window.Resources>

 <Border x:Name="RootBorder"
  CornerRadius="23"
  Background="#D91B2D4A"
  BorderBrush="#99A8E8FF"
  BorderThickness="1"
  Padding="10">

  <Border.Effect>
   <DropShadowEffect BlurRadius="30"
    ShadowDepth="2"
    Opacity=".48"
    Color="#050B18"/>
  </Border.Effect>

  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <!-- Header -->
   <Grid Grid.Row="0" Margin="5,2,5,6"
    MouseLeftButtonDown="Header_MouseLeftButtonDown">

    <Grid.ColumnDefinitions>
     <ColumnDefinition/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel>
     <TextBlock Text="PERSIAGLASS / DESKTOP"
      FontSize="9"
      Foreground="#FF76D9E8"
      FontWeight="Bold"/>
     <TextBlock Text="داشبورد هوشمند رومیزی"
      FontSize="17"
      FontWeight="SemiBold"/>
    </StackPanel>

    <StackPanel Grid.Column="1"
     Orientation="Horizontal"
     FlowDirection="LeftToRight">

     <Button x:Name="PinButton"
      Style="{StaticResource Action}"
      Content="📌"
      Click="Pin_Click"/>

     <Button x:Name="LockButton"
      Style="{StaticResource Action}"
      Content="🔓"
      Click="Lock_Click"/>

     <Button Style="{StaticResource Action}"
      Content="—"
      Click="Minimize_Click"/>

     <Button Style="{StaticResource Action}"
      Content="×"
      Click="Close_Click"/>
    </StackPanel>
   </Grid>

   <!-- Clock -->
   <Border Grid.Row="1"
    Style="{StaticResource Card}"
    Margin="3,2,3,5"
    BorderBrush="#8875E6E8">

    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>

     <StackPanel>
      <TextBlock x:Name="ClockText"
       Text="۰۰:۰۰:۰۰"
       FontSize="31"
       FontWeight="Light"/>

      <TextBlock x:Name="JalaliText"
       Text="تاریخ شمسی"
       FontSize="16"
       Foreground="#FFB6E8F1"/>

      <TextBlock x:Name="WeekdayText"
       Text="روز هفته"
       Style="{StaticResource Small}"/>

      <TextBlock x:Name="GregorianText"
       Text="Gregorian"
       Style="{StaticResource Small}"
       FlowDirection="LeftToRight"/>

      <TextBlock x:Name="HijriText"
       Text="Hijri"
       Style="{StaticResource Small}"/>
     </StackPanel>

     <StackPanel Grid.Column="1"
      VerticalAlignment="Center"
      Margin="12,0,0,0">

      <TextBlock Text="اهواز"
       Foreground="#FF7FE3D0"
       FontSize="13"
       HorizontalAlignment="Center"/>

      <TextBlock Text="☀"
       FontSize="34"
       HorizontalAlignment="Center"
       Foreground="#FFFFD17B"/>

      <TextBlock Text="وضعیت هوا"
       Style="{StaticResource Small}"
       HorizontalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- Dashboard -->
   <Grid Grid.Row="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="1.05*"/>
     <RowDefinition Height=".88*"/>
     <RowDefinition Height=".78*"/>
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
     <ColumnDefinition/>
     <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- Calendar -->
    <Border Grid.Row="0"
     Grid.ColumnSpan="2"
     Style="{StaticResource Card}">

     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>

       <TextBlock Text="تقویم و مناسبت‌ها"
        FontWeight="SemiBold"
        Foreground="#FFBDA7FF"/>

       <Button Grid.Column="2"
        Style="{StaticResource Action}"
        Content="امروز"
        Click="Today_Click"/>

       <StackPanel Grid.Column="1"
        Orientation="Horizontal"
        FlowDirection="LeftToRight">

        <Button Style="{StaticResource Action}"
         Content="‹"
         Click="NextMonth_Click"/>

        <Button Style="{StaticResource Action}"
         Content="›"
         Click="PreviousMonth_Click"/>
       </StackPanel>
      </Grid>

      <TextBlock x:Name="MonthText"
       Grid.Row="1"
       Text="ماه"
       FontSize="12"
       HorizontalAlignment="Center"
       Margin="0,1,0,5"
       Foreground="#FFB8D9FF"/>

      <UniformGrid x:Name="CalendarGrid"
       Grid.Row="2"
       Columns="7"/>
     </Grid>
    </Border>

    <!-- Weather -->
    <Border Grid.Row="1"
     Grid.Column="0"
     Style="{StaticResource Card}">

     <StackPanel>
      <TextBlock Text="آب‌وهوای اهواز"
       Foreground="#FF7FE3D0"
       FontWeight="SemiBold"/>

      <TextBlock x:Name="WeatherTemp"
       Text="— °"
       FontSize="24"
       Margin="0,4"/>

      <TextBlock x:Name="WeatherDetails"
       Text="رطوبت — | باد —"
       Style="{StaticResource Small}"/>

      <TextBlock x:Name="WeatherStatus"
       Text="در انتظار اتصال"
       Style="{StaticResource Small}"
       Margin="0,4"/>

      <TextBlock Text="پیش‌بینی ۷ روزه و AQI"
       Style="{StaticResource Small}"/>
     </StackPanel>
    </Border>

    <!-- Markets -->
    <Border Grid.Row="1"
     Grid.Column="1"
     Style="{StaticResource Card}">

     <StackPanel>
      <TextBlock Text="بازارها"
       Foreground="#FFFFCF7A"
       FontWeight="SemiBold"/>

      <TextBlock Text="دلار آزاد"
       Style="{StaticResource Small}"
       Margin="0,6,0,0"/>

      <TextBlock x:Name="UsdValue"
       Text="— تومان"
       FontSize="16"/>

      <TextBlock Text="طلای ۱۸ عیار · هر گرم"
       Style="{StaticResource Small}"
       Margin="0,5,0,0"/>

      <TextBlock x:Name="GoldValue"
       Text="— تومان"
       FontSize="16"
       Foreground="#FFFFD27C"/>

      <TextBlock Text="نفت برنت"
       Style="{StaticResource Small}"
       Margin="0,5,0,0"/>

      <TextBlock x:Name="BrentValue"
       Text="— دلار/بشکه"
       FontSize="14"/>

      <TextBlock Text="منبع قیمت در انتظار اتصال"
       Style="{StaticResource Small}"
       Margin="0,4,0,0"/>
     </StackPanel>
    </Border>

    <!-- Prayer -->
    <Border Grid.Row="2"
     Grid.Column="0"
     Style="{StaticResource Card}">

     <StackPanel>
      <TextBlock Text="خورشید و نماز"
       Foreground="#FFFFA9C8"
       FontWeight="SemiBold"/>

      <TextBlock Text="طلوع خورشید"
       Style="{StaticResource Small}"
       Margin="0,7,0,0"/>

      <TextBlock Text="—:—" FontSize="15"/>

      <TextBlock Text="غروب خورشید"
       Style="{StaticResource Small}"
       Margin="0,4,0,0"/>

      <TextBlock Text="—:—" FontSize="15"/>

      <TextBlock Text="اوقات شرعی: منبع تعیین نشده"
       Style="{StaticResource Small}"
       Margin="0,5,0,0"/>
     </StackPanel>
    </Border>

    <!-- Reminders -->
    <Border Grid.Row="2"
     Grid.Column="1"
     Style="{StaticResource Card}">

     <StackPanel>
      <TextBlock Text="یادآورها و شمارش"
       Foreground="#FFBDA7FF"
       FontWeight="SemiBold"/>

      <TextBlock x:Name="ReminderText"
       Text="یادآوری ثبت نشده"
       FontSize="12"
       Margin="0,8,0,0"/>

      <TextBlock Text="پیشرفت ماه"
       Style="{StaticResource Small}"
       Margin="0,7,0,0"/>

      <ProgressBar x:Name="MonthProgress"
       Height="7"
       Value="0"
       Maximum="100"
       Foreground="#FF70D9C5"
       Background="#334A6078"/>

      <TextBlock x:Name="ProgressText"
       Text="—"
       Style="{StaticResource Small}"
       Margin="0,4,0,0"/>

      <Button Content="تنظیمات"
       Style="{StaticResource Action}"
       HorizontalAlignment="Left"
       Click="Settings_Click"/>
     </StackPanel>
    </Border>
   </Grid>

   <DockPanel Grid.Row="3" Margin="5,5,5,0">
    <TextBlock x:Name="StatusText"
     Text="آماده"
     Style="{StaticResource Small}"
     VerticalAlignment="Center"/>

    <TextBlock Text="V2"
     Foreground="#FF7FE3D0"
     FontSize="10"
     DockPanel.Dock="Left"/>
   </DockPanel>

  </Grid>
 </Border>
</Window>
```
